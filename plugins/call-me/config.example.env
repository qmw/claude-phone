# Copy to ~/.config/claude-call-me/config.env and chmod 600 it.
# Environment variables with the same names override this file.

# Required
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567   # your Twilio number (E.164)
CALL_ME_TO_NUMBER=+48500000000    # your phone (E.164); must be verified if on a Twilio trial

# Optional
# CALL_ME_LANGUAGE=en-US          # speech recognition + TTS language, e.g. pl-PL
# CALL_ME_VOICE=Polly.Joanna      # Twilio <Say> voice, e.g. Polly.Ewa for Polish
# CALL_ME_INTRO=Hi, this is Claude.
# CALL_ME_REPLY_PROMPT=Please say your reply now, or press a key.
# CALL_ME_ACK=Got it, thanks. Goodbye.
# CALL_ME_PUBLIC_URL=https://...  # your own public URL forwarding to CALL_ME_PORT (skips cloudflared)
# CALL_ME_PORT=0                  # local webhook port (0 = random)
