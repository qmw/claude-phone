# Copy to ~/.config/claude-call-me/config.env and chmod 600 it.
# Environment variables with the same names override this file.

# Required
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567   # your Twilio number (E.164)
CALL_ME_TO_NUMBER=+48500000000    # your phone (E.164); must be verified if on a Twilio trial
# CALL_ME_ALLOWED_CALLERS=+48600000001,+48600000002   # more phones allowed to call in (inbound)
# CALL_ME_MACHINE=laptop                             # name reported with inbound calls (default: hostname)

# Optional
# CALL_ME_LANGUAGE=en-US          # default call language: en-US or pl-PL (calls can override per call)
# CALL_ME_VOICE=Polly.Joanna      # voice for the default language (built-in: Polly.Joanna / Polly.Ewa)
# CALL_ME_INTRO=Hi, this is Claude.
# CALL_ME_REPLY_PROMPT=Please say your reply now.   (default: nothing, the line ends with the message)
# CALL_ME_ACK=Got it, thanks. Goodbye.
# CALL_ME_RETRIES=4              # extra attempts when you don't pick up
# CALL_ME_RETRY_DELAY=90          # seconds between attempts
# CALL_ME_DND_MINUTES=120         # after a rejected call, hold further calls until you call back (or this long)
# CALL_ME_AMD=1                   # answering-machine detection (detects rejected -> voicemail); 0 to disable
# CALL_ME_PUBLIC_URL=https://...  # your own public URL forwarding to CALL_ME_PORT (skips cloudflared)
# CALL_ME_PORT=0                  # local webhook port (0 = random)
# CALL_ME_LIVE=0          # inbound calls hang up after you speak instead of a live conversation
# CALL_ME_LIVE_HOLD=120   # seconds on hold waiting for Claude's next line
